<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_ffffff_r10"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="温馨提示"
        android:textSize="20sp"
        android:textColor="@color/colorBlack"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 提示 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="手动设置起点存在越界风险，请检查范围"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#8a8a8a"
        android:gravity="center" />

    <!-- 图示 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@mipmap/ic_linejugde_tips"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dialog_linejugde"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_white_green_1e853a_r30"
            android:gravity="center"
            android:text="预览范围"
            android:textColor="@color/colorGreen"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_dialog_engrave"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_green_1e853a_r30"
            android:gravity="center"
            android:text="雕刻"
            android:textColor="@color/colorWhite"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_cancel"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/icon_cancel"
        android:layout_gravity="center"/>

</LinearLayout>
