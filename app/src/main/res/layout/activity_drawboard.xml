<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ColorGray"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorWhite">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="画图"
            android:textColor="@color/colorBlack"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_green_1e853a_r100"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="下一步"
            android:textColor="@color/colorWhite"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 机器名称 & 连接状态 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_ffffff_r20"
        android:layout_margin="10dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_machine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text=""
            android:textColor="@color/colorBlack"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态："
                android:textColor="@color/colorBlack"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_machine_status_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_red_c42b1c_r100"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="未连接"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp">

        <!-- 内容中心 -->
        <LinearLayout
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_above="@id/ll_function"
            android:background="@drawable/bg_white_ffffff_r10">

            <com.king.drawboard.view.DrawBoardView
                android:id="@+id/drawBoardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- 底部功能 -->
        <LinearLayout
            android:id="@+id/ll_function"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_ffffff_r10"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:layout_alignParentBottom="true">

            <!-- 功能 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前模式："
                        android:textColor="@color/colorBlack"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <!-- 绘画模式 -->
                    <TextView
                        android:id="@+id/tv_draw_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="20sp"
                        android:textColor="@color/colorGreen"/>

                </LinearLayout>

                <!-- 功能 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">

                    <!-- 路径 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 路径 -->
                        <LinearLayout
                            android:id="@+id/ll_path"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_pen_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="路径"/>


                        </LinearLayout>

                        <!-- 直线 -->
                        <LinearLayout
                            android:id="@+id/ll_line"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_line_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="直线"/>


                        </LinearLayout>

                        <!-- 矩形 -->
                        <LinearLayout
                            android:id="@+id/ll_rectangle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_rectangle_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="矩形"/>


                        </LinearLayout>

                    </LinearLayout>

                    <!-- 圆形 & 圆形 & 马赛克 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp">

                        <!-- 椭圆 -->
                        <LinearLayout
                            android:id="@+id/ll_oval"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_oval_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="椭圆"/>


                        </LinearLayout>

                        <!-- 圆形 -->
                        <LinearLayout
                            android:id="@+id/ll_circle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_circle_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="圆形"/>


                        </LinearLayout>

                        <!-- 马赛克 -->
                        <LinearLayout
                            android:id="@+id/ll_mosic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_mosic_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="马赛克"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 橡皮擦 & 颜色 & 粗细 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp">

                        <!-- 橡皮擦 -->
                        <LinearLayout
                            android:id="@+id/ll_eraser"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_tool_eraser_white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="橡皮擦"/>


                        </LinearLayout>

                        <!-- 颜色 -->
                        <LinearLayout
                            android:id="@+id/ll_color"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/iv_color"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@color/colorBlack"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="颜色"/>


                        </LinearLayout>

                        <!-- 粗细 -->
                        <LinearLayout
                            android:id="@+id/ll_size"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_size"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="粗细"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 撤销 & 清除 & 恢复  -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <!-- 撤销 -->
                        <LinearLayout
                            android:id="@+id/ll_undo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_undo"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="撤销"/>


                        </LinearLayout>

                        <!-- 清除 -->
                        <LinearLayout
                            android:id="@+id/ll_clean"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_clean"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="清除"/>
                        </LinearLayout>

                        <!-- 恢复 -->
                        <LinearLayout
                            android:id="@+id/ll_redo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_green_1e853a_r10"
                            android:layout_marginStart="15dp"
                            android:padding="5dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_redo"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/colorWhite"
                                android:layout_marginTop="5dp"
                                android:text="恢复"/>


                        </LinearLayout>



                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>



        </LinearLayout>


    </RelativeLayout>

</LinearLayout>