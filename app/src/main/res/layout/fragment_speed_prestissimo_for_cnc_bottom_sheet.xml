<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rg_speed_prestissimo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_white_ffffff_topradius30"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="20dp"
    tools:context=".fragment.WifiChooseBottomSheetFragment">

    <RadioButton
        android:id="@+id/rb_1200"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/step_setup_bg_color_selector"
        android:button="@null"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="1200mm/min"
        android:textColor="@drawable/step_setup_text_color_selector"
        android:textSize="14sp" />

    <RadioButton
        android:id="@+id/rb_1300"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/step_setup_bg_color_selector"
        android:button="@null"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingVertical="10dp"
        android:text="1300mm/min"
        android:textColor="@drawable/step_setup_text_color_selector"
        android:textSize="14sp" />

    <RadioButton
        android:id="@+id/rb_1400"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/step_setup_bg_color_selector"
        android:button="@null"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingVertical="10dp"
        android:text="1400mm/min"
        android:textColor="@drawable/step_setup_text_color_selector"
        android:textSize="14sp" />

    <RadioButton
        android:id="@+id/rb_1500"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/step_setup_bg_color_selector"
        android:button="@null"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingVertical="10dp"
        android:text="1500mm/mim"
        android:textColor="@drawable/step_setup_text_color_selector"
        android:textSize="14sp" />

    <RadioButton
        android:id="@+id/rb_1600"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/step_setup_bg_color_selector"
        android:button="@null"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingVertical="10dp"
        android:text="1600mm/min"
        android:textColor="@drawable/step_setup_text_color_selector"
        android:textSize="14sp" />




</RadioGroup>