<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_ffffff_r10"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 名字 -->
    <TextView
        android:id="@+id/tv_machine_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Laser Master 3"
        android:textColor="@color/colorBlack"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 状态 -->
    <TextView
        android:id="@+id/tv_machine_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_green_1e853a_r100"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="可连接"
        android:textColor="@color/colorWhite"
        android:textSize="12sp" />

    <!-- 图片 -->
    <ImageView
        android:id="@+id/iv_machine_image"
        android:layout_width="210dp"
        android:layout_height="85dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:src="@mipmap/ic_laser_t4" />

    <!-- 设备信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_gray_e6e6e6_r10"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 尺寸 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_machine_size" />

                <TextView
                    android:id="@+id/tv_machine_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="400x400(mm²)"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 芯片 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_firmware" />

                <TextView
                    android:id="@+id/tv_machine_firmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ESP_PRO_V2"
                    android:textColor="#A3A3A3"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- 激光模组 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_module_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_laser" />

                <TextView
                    android:id="@+id/tv_laser_module"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="LD_20A_1.6W"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- SD卡 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_sdcard" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="/"
                    android:textColor="#A3A3A3"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 结构尺寸 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="构件尺寸"
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tv_component_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="400x400(mm²)"
            android:textColor="#8A8A8A" />

    </RelativeLayout>

    <!-- 激光模组 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/tv_module_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="激光模组"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"
                android:textColor="#8A8A8A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:textSize="20sp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />


        </LinearLayout>




        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_gray_e6e6e6_r10"
            android:paddingHorizontal="5dp">

            <Spinner
                android:id="@+id/spinner_laser_module"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"
                  />
        </LinearLayout>



    </RelativeLayout>

    <!-- 确认连接 -->
    <TextView
        android:id="@+id/tv_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="确认连接"
        android:textSize="14sp"
        android:textColor="@color/colorWhite"
        android:background="@drawable/bg_green_1e853a_r100"
        android:padding="10dp"
        android:layout_marginTop="25dp"/>

    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="取消连接"
        android:textSize="14sp"
        android:textColor="#8A8A8A"
        android:gravity="center"
        android:layout_marginTop="10dp"/>

</LinearLayout>
